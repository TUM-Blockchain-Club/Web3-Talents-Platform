{
  "name": "web3-talents-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm --filter @web3-talents/core build && pnpm --filter @web3-talents/api build && pnpm --filter @web3-talents/web build",
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @web3-talents/core test && pnpm --filter @web3-talents/api test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
