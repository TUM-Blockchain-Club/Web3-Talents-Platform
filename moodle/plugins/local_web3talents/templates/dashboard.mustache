{{!
    This file is part of Moodle - http://moodle.org/

    @template local_web3talents/dashboard
}}
<section class="local-web3talents-dashboard" aria-labelledby="w3t-admin-title">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <p class="text-muted small mb-2">{{#str}}dashboard_admin_label, local_web3talents{{/str}}</p>
            <h2 id="w3t-admin-title">{{#str}}dashboard_welcome, local_web3talents{{/str}}</h2>
            <p class="text-muted">{{#str}}dashboard_guide, local_web3talents{{/str}}</p>
        </div>
        {{#coursefound}}<a class="btn btn-outline-secondary" href="{{courseurl}}">{{#str}}dashboard_open_course, local_web3talents{{/str}} <span aria-hidden="true">↗</span></a>{{/coursefound}}
    </header>

    {{^coursefound}}
        <div class="alert alert-warning">{{coursenotfound}} <a href="{{settingsurl}}">{{#str}}settings, local_web3talents{{/str}}</a></div>
    {{/coursefound}}
    {{^enabled}}
        <div class="alert alert-warning">{{#str}}dashboard_disabled_help, local_web3talents{{/str}} <a href="{{settingsurl}}">{{#str}}settings, local_web3talents{{/str}}</a></div>
    {{/enabled}}

    {{#coursefound}}
    <section class="w3t-admin-weekly" aria-labelledby="w3t-weekly-title">
        <h3 id="w3t-weekly-title">{{#str}}dashboard_weekly_title, local_web3talents{{/str}}</h3>
        <p class="text-muted">{{#str}}dashboard_weekly_help, local_web3talents{{/str}}</p>
        <ol class="row list-unstyled g-3 mb-4">
            {{#weeklylinks}}
            <li class="w3t-admin-step col-12 col-lg-4">
                <div class="card h-100"><div class="card-body">
                <p class="text-muted small mb-2">{{#str}}dashboard_step, local_web3talents{{/str}} {{step}}</p>
                <h4 class="h5"><a href="{{url}}">{{label}} <span aria-hidden="true">→</span></a></h4>
                <p class="mb-0">{{description}}</p>
                </div></div>
            </li>
            {{/weeklylinks}}
        </ol>
    </section>
    {{/coursefound}}

    <details class="w3t-admin-section border rounded p-3 mb-3" id="w3t-admin-setup" {{^coursefound}}open{{/coursefound}}>
        <summary><span class="fw-bold">{{#str}}dashboard_setup_title, local_web3talents{{/str}}</span><span class="d-block small text-muted mt-1">{{#str}}dashboard_setup_help, local_web3talents{{/str}}</span></summary>
        <ul class="list-unstyled mt-3 mb-0">
            {{#setuplinks}}
            <li class="border-top pt-3"><a href="{{url}}">{{label}} <span aria-hidden="true">→</span></a><p class="small text-muted mt-1">{{description}}</p></li>
            {{/setuplinks}}
        </ul>
    </details>

    {{#coursefound}}
    <details class="w3t-admin-section border rounded p-3 mb-3">
        <summary><span class="fw-bold">{{#str}}dashboard_mentors_title, local_web3talents{{/str}}</span><span class="d-block small text-muted mt-1">{{#str}}dashboard_mentors_help, local_web3talents{{/str}}</span></summary>
        <ul class="list-unstyled mt-3 mb-0">
            {{#mentorlinks}}
            <li class="border-top pt-3"><a href="{{url}}">{{label}} <span aria-hidden="true">→</span></a><p class="small text-muted mt-1">{{description}}</p></li>
            {{/mentorlinks}}
        </ul>
    </details>
    {{/coursefound}}

    <details class="w3t-admin-section w3t-admin-advanced border rounded p-3 mb-3">
        <summary><span class="fw-bold">{{#str}}dashboard_advanced_title, local_web3talents{{/str}}</span><span class="d-block small text-muted mt-1">{{#str}}dashboard_advanced_help, local_web3talents{{/str}}</span></summary>
        <ul class="list-unstyled mt-3 mb-0">
            {{#advancedlinks}}
            <li class="border-top pt-3"><a href="{{url}}">{{label}} <span aria-hidden="true">→</span></a><p class="small text-muted mt-1">{{description}}</p></li>
            {{/advancedlinks}}
        </ul>
        {{#coursefound}}
        <div class="border-top pt-3 mt-3">
            <h4>{{#str}}dashboard_role_views, local_web3talents{{/str}}</h4>
            <p class="text-muted">{{#str}}dashboard_role_help, local_web3talents{{/str}}</p>
            <ul>{{#viewlinks}}<li><a href="{{url}}">{{label}}</a></li>{{/viewlinks}}</ul>
        </div>
        {{/coursefound}}
    </details>
</section>
