{{!
    @template theme_web3talents/footer
    Shared Web3 Talents footer. Expects: logourl, linkedinurl, footernav1, footernav2, loginurl, tumurl, contacturl.
}}
<footer class="web3t-footer" aria-label="Site footer">
    <div class="web3t-footer__bg" aria-hidden="true"></div>
    <div class="web3t-footer__inner">
        <div class="web3t-footer__brand">
            <img src="{{logourl}}" alt="Web3 Talents" class="web3t-footer__logo">
            <p class="web3t-footer__tagline">{{#str}}footertagline, theme_web3talents{{/str}}</p>
            <a class="web3t-btn web3t-btn--primary web3t-footer__apply" href="{{loginurl}}">{{#str}}footerapply, theme_web3talents{{/str}}</a>
        </div>
        <nav class="web3t-footer__nav" aria-label="Footer">
            <ul>
                {{#footernav1}}<li><a href="{{url}}">{{label}}</a></li>{{/footernav1}}
            </ul>
            <ul>
                {{#footernav2}}<li><a href="{{url}}">{{label}}</a></li>{{/footernav2}}
            </ul>
        </nav>
        <div class="web3t-footer__social">
            <a href="{{tumurl}}" aria-label="LinkedIn"><img src="{{linkedinurl}}" alt="" class="web3t-footer__linkedin"></a>
            <a class="web3t-footer__contact" href="{{contacturl}}">{{#str}}footercontact, theme_web3talents{{/str}}</a>
        </div>
    </div>
    <div class="web3t-footer__bar">
        <span>{{#str}}footerpoweredby, theme_web3talents{{/str}}</span>
        <a class="web3t-footer__poweredby" href="{{tumurl}}">TUM Blockchain Club</a>
    </div>
</footer>
