{{!
    @template theme_web3talents/scripts
    Shared vanilla-JS interactions: mobile nav, stacked-card hover-preview/click-keep,
    dot sliders, tabs, accordions, smooth in-page scrolling. No dependencies.
}}
<script>
(function () {
    "use strict";
    var root = document.querySelector(".web3t");
    if (!root) { return; }
    var canHover = window.matchMedia("(hover: hover)").matches;

    // Mobile navigation toggle.
    var nav = root.querySelector("[data-nav]");
    var toggle = root.querySelector("[data-nav-toggle]");
    if (nav && toggle) {
        toggle.addEventListener("click", function () {
            var open = nav.classList.toggle("is-open");
            toggle.setAttribute("aria-expanded", open ? "true" : "false");
        });
    }

    // Stacked-card carousel: hover a card to preview it in front, click to keep it.
    root.querySelectorAll('[data-carousel="stack"]').forEach(function (box) {
        var cards = Array.prototype.slice.call(box.querySelectorAll("[data-card]"));
        if (cards.length < 2) { return; }
        var committed = cards.findIndex(function (c) { return c.classList.contains("is-front"); });
        if (committed < 0) { committed = 0; }

        function render(active) {
            cards.forEach(function (c, i) {
                c.classList.toggle("is-front", i === active);
                c.classList.toggle("is-back", i !== active);
                c.setAttribute("aria-hidden", i === active ? "false" : "true");
            });
        }
        cards.forEach(function (card, i) {
            if (canHover) {
                card.addEventListener("mouseenter", function () { render(i); });
                card.addEventListener("mouseleave", function () { render(committed); });
            }
            card.addEventListener("click", function () { committed = i; render(committed); });
            card.addEventListener("keydown", function (e) {
                if (e.key === "Enter" || e.key === " ") { e.preventDefault(); committed = i; render(committed); }
            });
        });
        render(committed);
    });

    // Dot sliders: build one dot per item; click to centre it; active dot tracks scroll.
    root.querySelectorAll('[data-carousel="slider"]').forEach(function (box) {
        var vp = box.querySelector("[data-scroller]");
        var dotsEl = box.querySelector("[data-dots]");
        if (!vp || !dotsEl) { return; }
        var items = Array.prototype.slice.call(vp.children);
        if (items.length < 2) { dotsEl.style.display = "none"; return; }

        var dots = items.map(function (item, i) {
            var d = document.createElement("button");
            d.type = "button";
            d.className = "web3t-dot";
            d.setAttribute("aria-label", "Go to item " + (i + 1));
            d.addEventListener("click", function () {
                vp.scrollTo({ left: item.offsetLeft - (vp.clientWidth - item.offsetWidth) / 2, behavior: "smooth" });
            });
            dotsEl.appendChild(d);
            return d;
        });

        function update() {
            var centre = vp.scrollLeft + vp.clientWidth / 2;
            var best = 0, bestDist = Infinity;
            items.forEach(function (it, i) {
                var mid = it.offsetLeft + it.offsetWidth / 2;
                var dist = Math.abs(mid - centre);
                if (dist < bestDist) { bestDist = dist; best = i; }
            });
            dots.forEach(function (d, i) { d.classList.toggle("is-active", i === best); });
        }
        var raf;
        vp.addEventListener("scroll", function () {
            window.cancelAnimationFrame(raf);
            raf = window.requestAnimationFrame(update);
        });
        update();
    });

    // Tabs.
    root.querySelectorAll("[data-tabs]").forEach(function (group) {
        var tabs = group.querySelectorAll("[data-tab]");
        var panels = group.querySelectorAll("[data-panel]");
        tabs.forEach(function (tab) {
            tab.addEventListener("click", function (e) {
                if (tab.tagName === "BUTTON") { e.preventDefault(); }
                var key = tab.getAttribute("data-tab");
                tabs.forEach(function (t) { t.classList.toggle("is-active", t === tab); });
                panels.forEach(function (p) { p.classList.toggle("is-active", p.getAttribute("data-panel") === key); });
            });
        });
    });

    // Accordions.
    root.querySelectorAll("[data-accordion]").forEach(function (head) {
        head.addEventListener("click", function () {
            var item = head.closest("[data-accordion-item]") || head.parentElement;
            var open = item.classList.toggle("is-open");
            head.setAttribute("aria-expanded", open ? "true" : "false");
        });
    });

    // Smooth in-page anchor scrolling.
    root.querySelectorAll('a[href^="#"]').forEach(function (a) {
        a.addEventListener("click", function (e) {
            var id = a.getAttribute("href");
            if (id.length > 1) {
                var target = document.querySelector(id);
                if (target) { e.preventDefault(); target.scrollIntoView({ behavior: "smooth", block: "start" }); }
            }
        });
    });
})();
</script>
