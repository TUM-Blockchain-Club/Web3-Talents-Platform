{{!
    @template theme_web3talents/nav
    Shared Web3 Talents top navigation (responsive; hamburger < 960px).
    Expects: homeurl, logourl, nav (label+url), loginurl.
}}
<header class="web3t-nav" data-nav>
    <a class="web3t-nav__brand" href="{{homeurl}}">
        <img src="{{logourl}}" alt="Web3 Talents" class="web3t-nav__logo">
    </a>
    <button class="web3t-nav__burger" type="button" data-nav-toggle aria-label="Toggle menu" aria-expanded="false">
        <span></span>
    </button>
    <div class="web3t-nav__menu">
        <nav class="web3t-nav__links" aria-label="Primary">
            {{#nav}}
                <a href="{{url}}">{{label}}</a>
            {{/nav}}
        </nav>
        <div class="web3t-nav__actions">
            <a class="web3t-btn web3t-btn--join" href="{{loginurl}}">Join Us</a>
            <a class="web3t-btn web3t-btn--ghost" href="{{loginurl}}">Login</a>
        </div>
    </div>
</header>
