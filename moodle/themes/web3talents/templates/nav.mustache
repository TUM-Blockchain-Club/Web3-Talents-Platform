{{!
    @template theme_web3talents/nav
    Shared Web3 Talents top navigation (responsive; hamburger < 1120px).
    Expects: brandurl, logourl, nav (label+url), loginurl and — from
    theme_web3talents_common_context() — isloggedin, accounturl, logouturl
    and initials.
}}
<header class="web3t-nav" data-nav>
    <a class="web3t-nav__brand" href="{{brandurl}}">
        <img src="{{logourl}}" alt="Web3 Talents" class="web3t-nav__logo">
    </a>
    <button class="web3t-nav__burger" type="button" data-nav-toggle aria-label="{{#str}}navmenu, theme_web3talents{{/str}}" aria-expanded="false">
        <span></span>
    </button>
    <div class="web3t-nav__menu">
        <nav class="web3t-nav__links" aria-label="Primary">
            {{#nav}}
                <a href="{{url}}">{{label}}</a>
            {{/nav}}
        </nav>
        <div class="web3t-nav__actions">
            {{#isloggedin}}
                <a class="web3t-nav__logout" href="{{logouturl}}">{{#str}}navlogout, theme_web3talents{{/str}}</a>
                <a class="web3t-nav__avatar" href="{{accounturl}}" aria-label="{{#str}}navprofile, theme_web3talents{{/str}}">{{initials}}</a>
            {{/isloggedin}}
            {{^isloggedin}}
                <a class="web3t-btn web3t-btn--join" href="{{loginurl}}">{{#str}}navjoin, theme_web3talents{{/str}}</a>
                <a class="web3t-btn web3t-btn--ghost" href="{{loginurl}}">{{#str}}navlogin, theme_web3talents{{/str}}</a>
            {{/isloggedin}}
        </div>
    </div>
</header>
