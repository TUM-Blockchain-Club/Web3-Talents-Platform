{{!
    This file is part of Moodle - http://moodle.org/

    @template theme_web3talents/dashboard

    Logged-in Web3 Talents student dashboard (Materials + Assignment views).
    Data is built by theme_web3talents_dashboard_context() from the
    local_web3talents plugin + Moodle core; empty states show where absent.
}}
<div class="web3t web3t-dashboard">

    {{> theme_web3talents/nav }}

    <div class="web3t-dash-shell">

        <aside class="web3t-dash-sidebar" aria-label="Course navigation">
            <div class="web3t-dash-upcoming">
                <p class="web3t-dash-upcoming__label">UPCOMING</p>
                {{#nextsession}}
                    <div class="web3t-dash-upcoming__row">
                        <img src="{{icons.video}}" alt="" class="web3t-dash-upcoming__icon">
                        <div class="web3t-dash-upcoming__body">
                            <p><strong>Next Session:</strong> <span>{{name}}</span></p>
                            <p class="web3t-dash-upcoming__when">{{when}}</p>
                        </div>
                    </div>
                {{/nextsession}}
                {{#assignmentdue}}
                    <div class="web3t-dash-upcoming__row">
                        <img src="{{icons.clock}}" alt="" class="web3t-dash-upcoming__icon">
                        <div class="web3t-dash-upcoming__body">
                            <p><strong>Assignment Due</strong></p>
                            <p class="web3t-dash-upcoming__when">{{when}}</p>
                        </div>
                    </div>
                {{/assignmentdue}}
                {{^nextsession}}{{^assignmentdue}}
                    <p class="web3t-dash-empty">No upcoming sessions scheduled.</p>
                {{/assignmentdue}}{{/nextsession}}
            </div>

            <nav class="web3t-dash-topics" aria-label="Topics">
                <p class="web3t-dash-topics__label">TOPICS</p>
                {{#topics}}
                    {{^locked}}
                        <a class="web3t-dash-topic{{#active}} is-active{{/active}}" href="{{url}}">
                            <span class="web3t-dash-topic__num">{{num}}</span>
                            <span class="web3t-dash-topic__text">
                                <span class="web3t-dash-topic__title">{{title}}
                                    {{#active}}<span class="web3t-dash-topic__pill">Current</span>{{/active}}
                                </span>
                                <span class="web3t-dash-topic__dates">{{dates}}</span>
                            </span>
                        </a>
                    {{/locked}}
                    {{#locked}}
                        <span class="web3t-dash-topic is-locked">
                            <span class="web3t-dash-topic__num">{{num}}</span>
                            <span class="web3t-dash-topic__text">
                                <span class="web3t-dash-topic__title">{{title}}</span>
                                <span class="web3t-dash-topic__dates">{{dates}}</span>
                            </span>
                            <img src="{{icons.lock}}" alt="Locked" class="web3t-dash-topic__lock">
                        </span>
                    {{/locked}}
                {{/topics}}
                {{^hastopics}}<p class="web3t-dash-empty">No topics scheduled yet.</p>{{/hastopics}}
            </nav>

            <div class="web3t-dash-sidebar__footer">
                <a class="web3t-dash-sidebar__action" href="{{allmaterialsurl}}">
                    <img src="{{icons.joinzoom}}" alt="">
                    <span>Join Zoom</span>
                </a>
                <a class="web3t-dash-sidebar__action" href="{{allmaterialsurl}}">
                    <img src="{{icons.book}}" alt="">
                    <span>All Course Materials</span>
                </a>
            </div>
        </aside>

        <main class="web3t-dash-main">

            <div class="web3t-dash-main__header">
                <nav class="web3t-dash-breadcrumb" aria-label="Breadcrumb">
                    <span>My Courses</span>
                    <img src="{{icons.chevron}}" alt="">
                    <span>{{coursename}}</span>
                </nav>
                <div class="web3t-dash-main__titlerow">
                    <div class="web3t-dash-main__title">
                        {{#currenttopic}}
                            <h1>{{title}}</h1>
                            <span class="web3t-dash-main__pill">{{weeklabel}}</span>
                        {{/currenttopic}}
                        {{^currenttopic}}
                            <h1>Your Course Overview</h1>
                        {{/currenttopic}}
                    </div>
                    {{#hastimeline}}
                        <div class="web3t-dash-timeline" role="list" aria-label="This week">
                            {{#timeline}}
                                <div class="web3t-dash-timeline__node is-{{state}}" role="listitem">
                                    <span class="web3t-dash-timeline__dot" aria-hidden="true"></span>
                                    <span class="web3t-dash-timeline__name">{{label}}</span>
                                    <span class="web3t-dash-timeline__date">{{date}}</span>
                                </div>
                            {{/timeline}}
                        </div>
                    {{/hastimeline}}
                </div>
            </div>

            <div class="web3t-dash-tabs" role="tablist" aria-label="Topic views">
                <a class="web3t-dash-tab{{#showmaterials}} is-active{{/showmaterials}}" href="{{materialsurl}}"
                    role="tab" aria-selected="{{#showmaterials}}true{{/showmaterials}}{{^showmaterials}}false{{/showmaterials}}">
                    <img src="{{icons.tabplay}}" alt="">
                    <span>Course Materials</span>
                </a>
                <a class="web3t-dash-tab{{#showassignment}} is-active{{/showassignment}}" href="{{assignmenturl}}"
                    role="tab" aria-selected="{{#showassignment}}true{{/showassignment}}{{^showassignment}}false{{/showassignment}}">
                    <img src="{{icons.tabdoc}}" alt="">
                    <span>Assignment</span>
                </a>
            </div>

            {{#showmaterials}}
                <div class="web3t-dash-panel web3t-dash-materials">
                    {{#speakerslides}}
                        <p class="web3t-dash-materials__label">SPEAKER SLIDES</p>
                        <div class="web3t-dash-row">
                            <span class="web3t-dash-row__tile web3t-dash-row__tile--play">
                                <img src="{{icons.play}}" alt="">
                            </span>
                            <span class="web3t-dash-row__text">
                                <span class="web3t-dash-row__title">{{title}}</span>
                                <span class="web3t-dash-row__meta">{{meta}}</span>
                            </span>
                            <a class="web3t-dash-download" href="{{url}}">
                                <img src="{{icons.download}}" alt="">
                                <span>Open</span>
                            </a>
                        </div>
                    {{/speakerslides}}

                    {{#teamrows.0}}
                        <div class="web3t-dash-materials__teams">
                            <div class="web3t-dash-materials__teamshead">
                                <span>COURSE MATERIALS</span>
                            </div>
                            {{#teamrows}}
                                <div class="web3t-dash-row">
                                    <span class="web3t-dash-row__tile">
                                        <img src="{{icons.monitor}}" alt="">
                                    </span>
                                    <span class="web3t-dash-row__text">
                                        <span class="web3t-dash-row__title">{{title}}</span>
                                        <span class="web3t-dash-row__meta">{{meta}}</span>
                                    </span>
                                    <a class="web3t-dash-download" href="{{url}}">
                                        <img src="{{icons.download}}" alt="">
                                        <span>Open</span>
                                    </a>
                                </div>
                            {{/teamrows}}
                        </div>
                    {{/teamrows.0}}

                    {{^hasmaterials}}
                        <p class="web3t-dash-empty web3t-dash-empty--panel">No materials have been uploaded for this topic yet.</p>
                    {{/hasmaterials}}
                </div>
            {{/showmaterials}}

            {{#showassignment}}
                <div class="web3t-dash-panel web3t-dash-assignment">

                    <div class="web3t-dash-assignment__col">
                        {{#assignment}}
                            <div class="web3t-dash-assignment__titlerow">
                                <div>
                                    <p class="web3t-dash-assignment__title">{{title}}</p>
                                    <p class="web3t-dash-assignment__due">{{due}}</p>
                                </div>
                                <span class="web3t-dash-assignment__status">{{status}}</span>
                            </div>

                            <div class="web3t-dash-card">
                                <p class="web3t-dash-card__title">Task Description</p>
                                <div class="web3t-dash-card__body">
                                    <p>{{taskdesc}}</p>
                                </div>
                            </div>

                            <div class="web3t-dash-card">
                                <p class="web3t-dash-card__title">Your Submission
                                    <img src="{{icons.info}}" alt="" class="web3t-dash-card__info"></p>
                                <p class="web3t-dash-card__sub">Upload your files on the assignment page</p>
                                <a class="web3t-dash-dropzone" href="{{submiturl}}">
                                    <span class="web3t-dash-dropzone__circle">
                                        <img src="{{icons.uploadcloud}}" alt="">
                                    </span>
                                    <p class="web3t-dash-dropzone__text">Go to submission &mdash; <strong>upload</strong></p>
                                    <p class="web3t-dash-dropzone__types">.zip · .pdf</p>
                                </a>
                            </div>
                        {{/assignment}}
                        {{^assignment}}
                            <p class="web3t-dash-empty web3t-dash-empty--panel">There&rsquo;s no assignment for this topic yet.</p>
                        {{/assignment}}
                    </div>

                    <aside class="web3t-dash-rail" aria-label="Team and mentor">
                        <div class="web3t-dash-rail__group">
                            <p class="web3t-dash-rail__label web3t-dash-rail__label--purple">YOUR TEAM</p>
                            {{#team}}
                                <div class="web3t-dash-member">
                                    <span class="web3t-dash-member__avatar">{{initials}}</span>
                                    <span class="web3t-dash-member__text">
                                        <span class="web3t-dash-member__name">{{name}}</span>
                                        <span class="web3t-dash-member__role">{{role}}</span>
                                    </span>
                                    <img src="{{icons.chat}}" alt="" class="web3t-dash-member__chat">
                                </div>
                            {{/team}}
                            {{^hasteam}}<p class="web3t-dash-empty">You haven&rsquo;t been assigned to a team yet.</p>{{/hasteam}}
                        </div>

                        <div class="web3t-dash-rail__group">
                            <p class="web3t-dash-rail__label web3t-dash-rail__label--purple">MENTOR</p>
                            {{#mentor}}
                                <div class="web3t-dash-member web3t-dash-member--mentor">
                                    <span class="web3t-dash-member__avatar web3t-dash-member__avatar--mentor">{{initials}}</span>
                                    <span class="web3t-dash-member__text">
                                        <span class="web3t-dash-member__name">{{name}}</span>
                                        <span class="web3t-dash-member__role">Mentor</span>
                                    </span>
                                    <img src="{{icons.chat}}" alt="" class="web3t-dash-member__chat">
                                </div>
                            {{/mentor}}
                            {{^hasmentor}}<p class="web3t-dash-empty">No mentor assigned yet.</p>{{/hasmentor}}
                        </div>

                        <div class="web3t-dash-rail__group">
                            <p class="web3t-dash-rail__label">MENTOR MATERIALS</p>
                            {{#resources}}
                                <a class="web3t-dash-resource" href="{{url}}">
                                    <span class="web3t-dash-resource__tile">
                                        <img src="{{typeicon}}" alt="">
                                    </span>
                                    <span class="web3t-dash-resource__label">{{label}}</span>
                                    <img src="{{icons.external}}" alt="" class="web3t-dash-resource__external">
                                </a>
                            {{/resources}}
                            {{^resources}}<p class="web3t-dash-empty">No mentor materials shared yet.</p>{{/resources}}
                        </div>
                    </aside>

                </div>
            {{/showassignment}}

        </main>

    </div>

    {{!
        The Figma Dashboard frame ends in a single "Powered by" bar rather than
        the full marketing footer, so this is intentionally NOT the shared
        theme_web3talents/footer partial.
    }}
    <div class="web3t-dash-bar">
        <span>{{#str}}footerpoweredby, theme_web3talents{{/str}}</span>
        <a class="web3t-dash-bar__pill" href="{{tumurl}}">{{#str}}navtumclub, theme_web3talents{{/str}}</a>
    </div>

    {{> theme_web3talents/scripts }}
</div>
