{{!
    @template theme_web3talents/courses
    Web3 Talents "Courses" overview page.
}}
<div class="web3t web3t-courses" id="top">

    {{> theme_web3talents/nav }}

    <section class="web3t-co-hero">
        <div class="web3t-co-hero__glow" aria-hidden="true"></div>
        <div class="web3t-rail">
            <h1 class="web3t-co-hero__title">Find your path into <span class="web3t-grad">Web3</span></h1>
            <p class="web3t-co-hero__sub">Cohort-based programs from beginner fundamentals to specialised tracks. Fully online, free, and peer-led.</p>
        </div>
    </section>

    <section class="web3t-co-cardsec" aria-label="Available courses">
        <div class="web3t-rail">
            <div class="web3t-co-cards-carousel" data-carousel="slider">
                <div class="web3t-co-cards" data-scroller>
                    {{#cards}}
                        <article class="web3t-co-card web3t-co-card--{{modifier}}">
                            <span class="web3t-co-card__glow" aria-hidden="true"></span>
                            <div class="web3t-co-card__top">
                                <p class="web3t-co-card__eyebrow">{{eyebrow}}</p>
                                <span class="web3t-co-card__badge">Applications Open</span>
                            </div>
                            <h3 class="web3t-co-card__title">{{title}}</h3>
                            <span class="web3t-co-card__underline" aria-hidden="true"></span>
                            <p class="web3t-co-card__sub">{{sub}}</p>
                            <hr class="web3t-co-card__divider">
                            <p class="web3t-co-card__date"><img src="{{calendaricon}}" alt="" class="web3t-co-card__cal">{{date}}</p>
                        </article>
                    {{/cards}}
                </div>
                <div class="web3t-dots" data-dots aria-label="Courses slider"></div>
            </div>
        </div>
    </section>

    <section class="web3t-co-structure" aria-labelledby="web3t-co-structure-title">
        <div class="web3t-rail">
            <div class="web3t-co-structure__head">
                <h2 id="web3t-co-structure-title" class="web3t-h2">Every course follows the same structure</h2>
                <p class="web3t-co-structure__sub">So you always know what&rsquo;s next</p>
            </div>

            <div class="web3t-co-timeline">
                {{#step1}}
                    <div class="web3t-co-step web3t-co-step--{{variant}}">
                        <div class="web3t-co-step__rail"><span class="web3t-co-badge" data-n="{{num}}">{{num}}</span></div>
                        <div class="web3t-co-scard web3t-co-scard--{{variant}}">
                            <div class="web3t-co-scard__tags">
                                <span class="web3t-co-pill">{{tag}}</span>
                                <span class="web3t-co-scard__label">{{label}}</span>
                            </div>
                            <p class="web3t-co-scard__heading"><img src="{{icon}}" alt="" class="web3t-co-scard__icon">{{heading}}</p>
                            <p class="web3t-co-scard__body">{{body}}</p>
                        </div>
                    </div>
                {{/step1}}

                <div class="web3t-co-cycle">
                    <div class="web3t-co-cycle__head">
                        <span class="web3t-co-pill web3t-co-pill--cycle">PROGRESSIVE LEARNING CYCLE</span>
                        <p class="web3t-co-cycle__caption">{{cyclecaption}}</p>
                    </div>
                    <div class="web3t-co-cycle__body">
                        {{#cyclesteps}}
                            <div class="web3t-co-step web3t-co-step--{{variant}}">
                                <div class="web3t-co-step__rail"><span class="web3t-co-badge" data-n="{{num}}">{{num}}</span></div>
                                <div class="web3t-co-scard web3t-co-scard--{{variant}}">
                                    <div class="web3t-co-scard__tags">
                                        <span class="web3t-co-pill">{{tag}}</span>
                                        <span class="web3t-co-scard__label">{{label}}</span>
                                    </div>
                                    <p class="web3t-co-scard__heading"><img src="{{icon}}" alt="" class="web3t-co-scard__icon">{{heading}}</p>
                                    {{#body}}<p class="web3t-co-scard__body">{{.}}</p>{{/body}}
                                    {{#list}}<ol class="web3t-co-scard__list">{{#items}}<li>{{text}}</li>{{/items}}</ol>{{/list}}
                                </div>
                            </div>
                        {{/cyclesteps}}
                    </div>
                    <div class="web3t-co-loopback">
                        <img src="{{loopbackicon}}" alt="" class="web3t-co-loopback__icon">
                        <p>The new lecture loops you back to <span class="web3t-co-loopback__step">Step 2</span> - a fresh subtopic each round.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{> theme_web3talents/footer }}
    {{> theme_web3talents/scripts }}

</div>
