{{!
    @template theme_web3talents/overview
    Public Web3 Talents landing page (TUM Blockchain Club design).
    Responsive: shared rail, flexible sections, working carousels/nav.

    Context: loginurl, coursesurl, communityurl, courseurl, homeurl, logourl,
    linkedinurl, tumurl, nav, footernav1, footernav2, courses[], steps[],
    speakers[], valuecards[], testimonials[].
}}
<div class="web3t web3t-home" id="top">

    {{> theme_web3talents/nav }}

    <section class="web3t-hero" aria-labelledby="web3t-hero-title">
        <div class="web3t-hero__bg" aria-hidden="true"></div>
        <div class="web3t-rail web3t-hero__inner">
            <p class="web3t-hero__pill">Next cohort starts <strong>August 2026</strong> · Applications close <strong>July 15</strong></p>
            <h1 id="web3t-hero-title">Your first steps into Web3 start here.</h1>
            <p class="web3t-hero__sub">Free. Peer-led. For every skill level.</p>
            <div class="web3t-hero__actions">
                <a class="web3t-btn web3t-btn--primary" href="{{coursesurl}}">Explore Courses →</a>
                <a class="web3t-btn web3t-btn--outline" href="{{communityurl}}">Join the Community →</a>
            </div>
        </div>
    </section>

    <section class="web3t-program" id="program" aria-labelledby="web3t-program-title">
        <div class="web3t-rail">
            <h2 id="web3t-program-title" class="web3t-h2">Our 20 Week Online Program</h2>
            <p class="web3t-program__notice">
                <span class="web3t-program__notice-icon" aria-hidden="true"></span>
                Upcoming courses with applications closing Dec 15
            </p>
            <div class="web3t-program__carousel" data-carousel="stack">
                <div class="web3t-stack">
                    {{#courses}}
                        <article class="web3t-course-card {{#front}}is-front{{/front}}{{^front}}is-back{{/front}}" data-card tabindex="0" role="button" aria-label="Show {{title}}">
                            <div class="web3t-course-card__main">
                                <h3>{{title}}</h3>
                                <p class="web3t-course-card__body">{{body}}</p>
                                <div class="web3t-course-card__actions">
                                    <a class="web3t-btn web3t-btn--primary web3t-btn--sm" href="{{loginurl}}">Apply Now</a>
                                    <a class="web3t-btn web3t-btn--outline web3t-btn--sm" href="{{courseurl}}">Course Details</a>
                                </div>
                            </div>
                            <div class="web3t-course-card__divider" aria-hidden="true"></div>
                            <dl class="web3t-course-card__info">
                                {{#info}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/info}}
                            </dl>
                        </article>
                    {{/courses}}
                </div>
            </div>
        </div>
    </section>

    <section class="web3t-steps" id="how" aria-labelledby="web3t-steps-title">
        <div class="web3t-rail web3t-steps__head">
            <h2 id="web3t-steps-title" class="web3t-h2">How Our Courses Work</h2>
            <p class="web3t-steps__sub">Our courses are build on a peer teaching style to ensure a thourough understanding of the material.</p>
        </div>
        <div class="web3t-steps__canvas">
            <div class="web3t-steps__art" aria-hidden="true"></div>
            <ol class="web3t-steps__list">
                {{#steps}}
                    <li class="web3t-step web3t-step--{{num}}">
                        <span class="web3t-step__badge" data-step="{{num}}">{{num}}</span>
                        <div class="web3t-step__text">
                            <h3>{{title}}</h3>
                            <p>{{{bodyhtml}}}</p>
                        </div>
                    </li>
                {{/steps}}
            </ol>
        </div>
    </section>

    <section class="web3t-speakers" id="speakers" aria-labelledby="web3t-speakers-title">
        <div class="web3t-rail">
            <div class="web3t-speakers__head">
                <h2 id="web3t-speakers-title" class="web3t-h2">Meet Our Speakers</h2>
                <p class="web3t-speakers__sub">Learn directly from the builders and leaders shaping the Web3 ecosystem.</p>
            </div>
            <div class="web3t-speakers__carousel" data-carousel="slider">
                <div class="web3t-speakers__scroller" data-scroller>
                    {{#speakers}}
                        <article class="web3t-speaker">
                            <img class="web3t-speaker__photo" src="{{photo}}" alt="{{name}}">
                            <h3 class="web3t-speaker__name">{{name}}</h3>
                            <p class="web3t-speaker__role">{{role}}</p>
                            <p class="web3t-speaker__org">{{org}}</p>
                            <p class="web3t-speaker__topic">{{topic}}</p>
                        </article>
                    {{/speakers}}
                </div>
                <div class="web3t-dots" data-dots aria-label="Speaker slider"></div>
            </div>
        </div>
    </section>

    <section class="web3t-values" aria-label="Why choose Web3 Talents">
        <div class="web3t-rail">
            <h2 class="web3t-h2 web3t-values__title">For every course we ensure</h2>
            <div class="web3t-values__grid">
                {{#valuecards}}
                    <article class="web3t-value-card web3t-value-card--{{modifier}}" tabindex="0">
                        <h3>{{title}}</h3>
                        <span class="web3t-value-card__icon" aria-hidden="true"></span>
                        <div class="web3t-value-card__reveal"><p>{{desc}}</p></div>
                    </article>
                {{/valuecards}}
            </div>
        </div>
    </section>

    <section class="web3t-community" id="community" aria-labelledby="web3t-community-title">
        <div class="web3t-rail">
            <h2 id="web3t-community-title" class="web3t-h2 web3t-community__title">
                You don&rsquo;t just get a course. You get a <span class="web3t-grad">community</span>.
            </h2>
            <p class="web3t-community__lead">
                Web3 Talents welcomes everyone, whether you&rsquo;ve never heard of blockchain or you&rsquo;re
                already working in the space as a seasoned professional, our teaching platform ensures you&rsquo;ll
                always have something to contribute and something new to discover.
            </p>
            <div class="web3t-community__carousel" data-carousel="slider">
                <div class="web3t-community__scroller" data-scroller>
                    {{#testimonials}}
                        <figure class="web3t-testimonial">
                            <img class="web3t-testimonial__avatar" src="{{avatar}}" alt="">
                            <blockquote>
                                <p>&ldquo;{{quote}}&rdquo;</p>
                                <figcaption>{{attribution}}</figcaption>
                            </blockquote>
                        </figure>
                    {{/testimonials}}
                </div>
                <div class="web3t-dots" data-dots aria-label="Testimonial slider"></div>
            </div>
            <div class="web3t-community__actions">
                <a class="web3t-btn web3t-btn--primary" href="{{loginurl}}">Find out more</a>
                <a class="web3t-btn web3t-btn--outline" href="{{tumurl}}">Check out TUM Blockchain</a>
            </div>
        </div>
    </section>

    {{> theme_web3talents/footer }}
    {{> theme_web3talents/scripts }}

</div>
